{
    "geode": "5.10.1",
    "gd": {
        "win": "2.2081",
        "android": "2.2081",
        "mac": "2.2081"
    },
    "id": "dontbeskid.level-complete-video",
    "name": "Level Complete Video",
    "version": "v1.0.0",
    "developer": "dontbeskid",
    "description": "Plays a custom video after you beat a level.",
    "settings": {
        "enabled": {
            "name": "Enabled",
            "type": "bool",
            "default": true
        },
        "fps": {
            "name": "Frame rate",
            "description": "Must match the fps used when extracting frames.",
            "type": "float",
            "default": 30.0,
            "min": 1.0,
            "max": 60.0
        },
        "display-mode": {
            "name": "Display mode",
            "description": "fit = вписать с чёрными полями, stretch = растянуть, window = окно поверх экрана.",
            "type": "string",
            "default": "fit",
            "one-of": ["fit", "stretch", "window"]
        },
        "window-scale": {
            "name": "Window size",
            "description": "Доля экрана в режиме window.",
            "type": "float",
            "default": 0.6,
            "min": 0.2,
            "max": 1.0
        },
        "audio-file": {
            "name": "Audio file",
            "type": "string",
            "default": "audio.ogg"
        },
        "only-first-completion": {
            "name": "Only on first completion",
            "type": "bool",
            "default": false
        },
        "preset-download": {
            "name": "Preset",
            "type": "custom:download-preset"
        },
        "telegram": {
            "name": "Telegram",
            "type": "custom:telegram-link"
        }
    }
}
